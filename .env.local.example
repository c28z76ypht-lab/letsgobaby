# Shopify Storefront API
# Get these from Shopify Admin > Settings > Apps and sales channels > Develop apps
# Create a Storefront API access token with these scopes:
# - unauthenticated_read_product_listings
# - unauthenticated_read_product_tags  
# - unauthenticated_read_collection_listings

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# When these are not set, the site uses sample data (good for development)

# Optional: full URL to a PNG/SVG logo (e.g. from Shopify Admin > Content > Files).
# If unset, the built-in wordmark SVGs are used.
# NEXT_PUBLIC_SITE_LOGO_URL=https://cdn.shopify.com/.../logo.png

# Optional: homepage alert banner (JSON). Used when Shopify shop metafield
# custom.home_banner is empty or unavailable. Same JSON shape as in Shopify.
# HOME_BANNER_JSON={"message":"Welcome!","href":"/contact","linkLabel":"Contact"}
#
# Shopify: Settings → Custom data → Store (Shop) → Metafield definition
# Namespace key: custom.home_banner · Type: JSON · Enable Storefront API access
# Example value:
# {"message":"Planning August? Order by 31 July ☀️","href":"/contact","linkLabel":"Get in touch"}
# Set "enabled": false to hide without deleting the metafield.

# --- PDF follow-ups (optional) ---

# Trustpilot TrustBox: get Business Unit ID + Template ID from Trustpilot admin
# (Integrations → TrustBoxes). Both required for the embed on the homepage.
# NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
# NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID=
# Optional: link “5.0 on Trustpilot” in the hero to your public profile
# NEXT_PUBLIC_TRUSTPILOT_PROFILE_URL=https://www.trustpilot.com/review/...

# Live chat (Tidio). Create a free account, copy the public key from the install snippet.
# NEXT_PUBLIC_TIDIO_PUBLIC_KEY=

# Porto mini-site: Shopify collection handle for Porto-specific catalog (same checkout).
# PORTO_COLLECTION_HANDLE=your-collection-handle
